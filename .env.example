# Xero API Configuration for Custom Connections
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here 
# Multi-client OAuth mode (Xero "Web app" + login for claude.ai connectors).
# Enabled when all of these are set; otherwise the server keeps the x-api-key mode only.
# XERO_CLIENT_ID / XERO_CLIENT_SECRET above must then belong to the Web app.
# Redirect URI to register in the Xero app: <PUBLIC_BASE_URL>/callback
PUBLIC_BASE_URL=https://your-service.up.railway.app
TOKEN_ENCRYPTION_KEY=at_least_32_random_characters
ALLOWED_XERO_EMAILS=you@example.com
# Token store file; defaults to $RAILWAY_VOLUME_MOUNT_PATH/oauth-store.json (or /data)
# OAUTH_STORE_PATH=/data/oauth-store.json
